{
  "name": "@wallet-core/evm",
  "version": "0.1.0",
  "description": "Non-custodial EVM wallet core with encrypted vaults, HD derivation and local signing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check .",
    "release:check": "pnpm run lint && pnpm run build && pnpm test && pnpm run format:check",
    "publish:npm": "node scripts/publish-npm.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ethereum",
    "evm",
    "wallet",
    "web3",
    "crypto",
    "non-custodial"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
